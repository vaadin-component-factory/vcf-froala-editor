<?xml version="1.0" encoding="UTF-8"?>
<!-- End-to-end module: Playwright tests that boot the demo app and drive it in a
     real browser. Depends on the demo so @SpringBootTest can start it. e2e runs
     in the `production` profile (after the demo's frontend bundle is built), via
     failsafe.

     Plain Playwright, deliberately without DramaFinder: DramaFinder 1.x is built
     against Vaadin 25 / JUnit 6 / Java 21 and does not fit this Vaadin 24 +
     Spring Boot 3 + JUnit 5 stack. The base class in SpringPlaywrightIT covers
     what we need from it. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.vaadin.componentfactory</groupId>
        <artifactId>vcf-froala-editor-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>vcf-froala-editor-e2e</artifactId>
    <name>Froala Editor for Vaadin Flow E2E</name>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>com.vaadin.componentfactory</groupId>
            <artifactId>vcf-froala-editor-demo</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>1.62.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>production</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <headless>true</headless>
                            </systemPropertyVariables>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
