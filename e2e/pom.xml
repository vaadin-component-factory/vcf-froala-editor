<?xml version="1.0" encoding="UTF-8"?>
<!-- End-to-end module: Playwright tests that boot their own small app and drive
     it in a real browser, via failsafe, always against a production bundle. Depends
     on the add-on only, never on the demo (maintainer, 2026-09-28). The demo's
     author has to stay free to change it.

     The app and its test views are test code in src/main/java; why is in
     docs/adr/0006. So that they never ship, deploy is skipped.

     Plain Playwright, deliberately without DramaFinder. The Vaadin 24 line cannot use
     it, and the test stack stays the same on both lines so tests can be taken over
     between them (docs/adr/0010). The base class in SpringPlaywrightIT covers what we
     need from it. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.vaadin.addons.componentfactory</groupId>
        <artifactId>vcf-froala-editor-parent</artifactId>
        <version>2.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>vcf-froala-editor-e2e</artifactId>
    <name>Froala Editor for Vaadin Flow E2E</name>
    <packaging>jar</packaging>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.vaadin.addons.componentfactory</groupId>
            <artifactId>vcf-froala-editor</artifactId>
            <version>2.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>1.62.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Always a production build, so a plain `mvn verify` runs the tests against the
         optimized bundle. No profile to forget. -->
    <build>
        <plugins>
            <plugin>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-maven-plugin</artifactId>
                <version>${vaadin.version}</version>
                <executions>
                    <execution>
                        <id>frontend</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>prepare-frontend</goal>
                            <goal>build-frontend</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- The real optimized build rather than the platform's pre-compiled
                         bundle, so route components load on demand as in production. -->
                    <forceProductionBuild>true</forceProductionBuild>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <headless>true</headless>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
