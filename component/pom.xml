<?xml version="1.0" encoding="UTF-8"?>
<!-- The add-on itself. STANDALONE on purpose: no <parent>, its own BOM imports
     and properties, so `mvn install` works here in isolation and the artifact
     can be published to the Vaadin Directory. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.vaadin.addons.componentfactory</groupId>
    <artifactId>vcf-froala-editor</artifactId>
    <version>1.0.1-SNAPSHOT</version>
    <name>Froala Editor</name>
    <packaging>jar</packaging>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <vaadin.version>24.10.7</vaadin.version>

        <!-- Test only. JUnit is pinned to what spring-boot-dependencies manages in the
             reactor root, so a standalone build of this module and a reactor build
             run the same version. Karibu's line is Vaadin-version-specific and not
             BOM-managed: 2.4.x -> Vaadin 24.8+ (not 25), 2.6.x+ -> Vaadin 25+. -->
        <junit-jupiter.version>5.12.2</junit-jupiter.version>
        <karibu-testing.version>2.4.4</karibu-testing.version>
        <maven-surefire.version>3.5.6</maven-surefire.version>

        <spotless.plugin.version>3.10.2</spotless.plugin.version>
        <!-- The formatter engines Spotless runs. Pinned, because otherwise they follow
             Spotless's own defaults and a plugin bump reformats the repo unasked.
             Moving prettier to 3.x is a deliberate one-off reformat. -->
        <prettier.version>2.8.8</prettier.version>
        <eclipse.formatter.version>4.40</eclipse.formatter.version>
        <checkstyle.plugin.version>3.6.0</checkstyle.plugin.version>
        <!-- 12.x, because Checkstyle 13 needs Java 21 and this line builds on Java 17 (ADR-0005). -->
        <checkstyle.version>12.3.1</checkstyle.version>
        <spotless.ratchetFrom></spotless.ratchetFrom>
        <!-- Where the shared eclipse/ + checkstyle/ config lives. Relative to this
             module rather than ${maven.multiModuleProjectDirectory}, because that
             property points at THIS module when the add-on is built standalone
             (`cd component && mvn install`). -->
        <codechecks.config.dir>${project.basedir}/..</codechecks.config.dir>

        <plugin.version.maven-source>3.4.0</plugin.version.maven-source>
        <plugin.version.maven-jar>3.5.0</plugin.version.maven-jar>
        <plugin.version.maven-assembly>3.8.0</plugin.version.maven-assembly>

    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-bom</artifactId>
                <version>${vaadin.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Spring-free on purpose: the official Vaadin add-on guide says an add-on
         depends on vaadin-core only and stays framework-agnostic, so it forces
         nothing on consumers. Anything Spring-shaped (the license-key
         @ConfigurationProperties binding, services) lives in the demo — or later
         in a separate optional `-spring` module. -->
    <dependencies>
        <!-- Also brings Jackson, which FroalaOptions parses JSON with. Not declared on its own,
             because the Vaadin BOM does not manage its version and Flow's own has to win. -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.bitbucket.cowwoc</groupId>
            <artifactId>diff-match-patch</artifactId>
            <version>1.2</version>
        </dependency>

        <!-- Test scope only, so the add-on still forces nothing on consumers. The
             plain karibu-testing-v10 artifact, NOT -spring: that one would pull
             Spring in, which this module must not have. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit-jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.github.mvysny.kaributesting</groupId>
            <artifactId>karibu-testing-v10</artifactId>
            <version>${karibu-testing.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Code-checks. This module has NO <parent>, so it inherits nothing from the
         reactor root — the Spotless/Checkstyle setup is duplicated here on
         purpose. Keep it in sync with the root pom. -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire.version}</version>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.plugin.version}</version>
                <configuration>
                    <ratchetFrom>${spotless.ratchetFrom}</ratchetFrom>
                    <java>
                        <eclipse>
                            <version>${eclipse.formatter.version}</version>
                            <file>${codechecks.config.dir}/eclipse/VaadinJavaConventions.xml</file>
                        </eclipse>
                        <endWithNewline/>
                        <removeUnusedImports/>
                        <importOrder>
                            <file>${codechecks.config.dir}/eclipse/vaadin.importorder</file>
                        </importOrder>
                        <forbidWildcardImports/>
                        <licenseHeader>
                            <file>${codechecks.config.dir}/eclipse/license-header.txt</file>
                        </licenseHeader>
                    </java>
                    <typescript>
                        <includes>
                            <include>src/**/*.js</include>
                            <include>src/**/*.ts</include>
                            <include>frontend/**/*.js</include>
                            <include>frontend/**/*.ts</include>
                        </includes>
                        <excludes>
                            <exclude>**/generated/**</exclude>
                        </excludes>
                        <prettier>
                            <prettierVersion>${prettier.version}</prettierVersion>
                            <configFile>${codechecks.config.dir}/.prettierrc</configFile>
                        </prettier>
                    </typescript>
                    <css>
                        <includes>
                            <include>src/**/*.css</include>
                            <include>frontend/**/*.css</include>
                        </includes>
                        <excludes>
                            <exclude>**/generated/**</exclude>
                            <!-- written by src/theme-generator, and the formatter would rewrite it so it no longer matches the output -->
                            <exclude>**/vcf-froala-theme-vaadin-rules.css</exclude>
                        </excludes>
                        <prettier>
                            <prettierVersion>${prettier.version}</prettierVersion>
                            <configFile>${codechecks.config.dir}/.prettierrc</configFile>
                        </prettier>
                    </css>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${checkstyle.plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${checkstyle.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>${codechecks.config.dir}/checkstyle/checkstyle.xml</configLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <violationSeverity>error</violationSeverity>
                    <failOnViolation>true</failOnViolation>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>directory</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <version>${plugin.version.maven-assembly}</version>
                        <configuration>
                            <appendAssemblyId>false</appendAssemblyId>
                            <descriptors>
                                <descriptor>assembly/assembly.xml</descriptor>
                            </descriptors>
                        </configuration>
                        <executions>
                            <execution>
                                <goals><goal>single</goal></goals>
                                <phase>install</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${plugin.version.maven-source}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <phase>verify</phase>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <version>${plugin.version.maven-jar}</version>
                        <configuration>
                            <archive>
                                <index>true</index>
                                <manifest>
                                    <addClasspath>false</addClasspath>
                                    <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                                </manifest>
                                <manifestEntries>
                                    <Vaadin-Package-Version>1</Vaadin-Package-Version>
                                    <Implementation-Vendor>n/a</Implementation-Vendor>
                                </manifestEntries>
                            </archive>
                            <excludes>
                                <exclude>META-INF/VAADIN/config/flow-build-info.json</exclude>
                                <exclude>rebel.xml</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
